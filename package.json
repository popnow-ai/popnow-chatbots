{
  "name": "popnow-chatbots",
  "version": "0.1.0",
  "private": true,
  "description": "PopNow for Discord and Slack: create images and videos with your PopNow credits from a chat.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "register:discord": "node scripts/register-discord-commands.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.151.0"
  }
}
